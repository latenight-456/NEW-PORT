  <svg viewBox="0 0 200 120" key="2">
    {Array.from({ length: 15 }, (_, i) => {
      const x = 46 + (i % 5) * 24, y = 24 + Math.floor(i / 5) * 26;
      return i === 7 ? (
        <circle key={i} className="r-own" cx={x + 8} cy={y + 8} r="11" />
