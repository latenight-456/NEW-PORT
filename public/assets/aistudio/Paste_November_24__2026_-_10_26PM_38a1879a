const DESK_ORDER = ["lamp", "laptop", "mug", "sketch", "stats", "phones", "phone"]; // one per hour

const svgPoint = (el: SVGGraphicsElement, x: number, y: number) => {
  const m = el.getScreenCTM();
  if (!m) return { x: 0, y: 0 };
  const pt = new DOMPoint(x, y).matrixTransform(m.inverse());
  return { x: pt.x, y: pt.y };
};

/* a soft beat for the headphones, made on the spot (no audio files) */
function makeBeat() {
  const AC = (window as any).AudioContext || (window as any).webkitAudioContext;
  if (!AC) return null;
  const ac: AudioContext = new AC();
  const out = ac.createGain();
  out.gain.value = 0.16;
  out.connect(ac.destination);
  const noise = ac.createBuffer(1, ac.sampleRate * 0.2, ac.sampleRate);
  const d = noise.getChannelData(0);
  for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
  const bass = [55, 55, 65.4, 49];
  let step = 0;
  const beat = 60 / 84 / 2;
  let next = ac.currentTime + 0.05;
  const hit = (t: number) => {
    const s = step % 16;
    if (s % 8 === 0 || s === 11) {
      const o = ac.createOscillator(), g = ac.createGain();
      o.frequency.setValueAtTime(120, t);
      o.frequency.exponentialRampToValueAtTime(42, t + 0.18);
      g.gain.setValueAtTime(1, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.3);
      o.connect(g).connect(out);
      o.start(t);
      o.stop(t + 0.32);
    }
    if (s % 2 === 1) {
      const n = ac.createBufferSource(), f = ac.createBiquadFilter(), g = ac.createGain();
      n.buffer = noise;
      f.type = "highpass";
      f.frequency.value = 7000;
      g.gain.value = s % 4 === 3 ? 0.35 : 0.18;
      n.connect(f).connect(g).connect(out);
      n.start(t);
      n.stop(t + 0.06);
    }
    if (s % 4 === 0) {
      const o = ac.createOscillator(), g = ac.createGain();
      o.type = "triangle";
      o.frequency.value = bass[Math.floor(step / 16) % 4] * 2;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.linearRampToValueAtTime(0.25, t + 0.03);
      g.gain.exponentialRampToValueAtTime(0.001, t + beat * 3.6);
      o.connect(g).connect(out);
      o.start(t);
      o.stop(t + beat * 4);
    }
    step++;
  };
  const timer = window.setInterval(() => {
    while (next < ac.currentTime + 0.12) {
      hit(next);
      next += beat;
    }
  }, 30);
  return {
    stop: () => {
      clearInterval(timer);
      ac.close();
    },
  };
}

function Desk({ step }: { step: number }) {
  const svg = useRef<SVGSVGElement>(null);
  const sketchRef = useRef<SVGGElement>(null);
  const statsRef = useRef<SVGGElement>(null);
  const [port, setPort] = useState(false);
  const [light, setLight] = useState<{ x: number; y: number } | null>(null);
  const [screen, setScreen] = useState(0);
  const [scan, setScan] = useState(0);
  const [sips, setSips] = useState(0);
  const [ripple, setRipple] = useState(0);
  const [lines, setLines] = useState<string[]>([]);
  const drawing = useRef<string | null>(null);
  const [bars, setBars] = useState([46, 72, 58, 96, 84, 118]);
  const dragBar = useRef<number>(-1);
  const [playing, setPlaying] = useState(false);
  const beat = useRef<{ stop: () => void } | null>(null);
  const [buzz, setBuzz] = useState(0);

  useEffect(() => {
    const mq = window.matchMedia("(max-width:720px)");
    const on = () => setPort(mq.matches);
    on();
    mq.addEventListener?.("change", on);
    return () => mq.removeEventListener?.("change", on);
  }, []);
  // music stops when you leave the scene
  useEffect(() => {
    const el = svg.current!;
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting && beat.current) {
        beat.current.stop();
        beat.current = null;
        setPlaying(false);
      }
    });
    io.observe(el);
    return () => {
      io.disconnect();
      beat.current?.stop();
    };
  }, []);

  const P = port ? PORT : LAND;
  const at2 = (k: string) => {
    const p = P[k];
    return `translate(${p.x} ${p.y}) rotate(${p.r || 0}) scale(${p.s || 1})`;
  };
  const arrive = (i: number) => ({ ["--a" as any]: i + 0.12, ["--d" as any]: 0.5 }) as React.CSSProperties;
  const ready = (k: string) => step >= DESK_ORDER.indexOf(k);

  const onMoveDesk = (e: React.PointerEvent<SVGSVGElement>) => {
    const p = svgPoint(svg.current!, e.clientX, e.clientY);
    setLight(p);
    if (drawing.current !== null && sketchRef.current) {
      const q = svgPoint(sketchRef.current, e.clientX, e.clientY);
      if (Math.abs(q.x) < 150 && Math.abs(q.y) < 100) {
        drawing.current += ` L${q.x.toFixed(1)} ${q.y.toFixed(1)}`;
        const d = drawing.current;
        setLines((l) => [...l.slice(0, -1), d]);
      }
    }
    if (dragBar.current >= 0 && statsRef.current) {
      const q = svgPoint(statsRef.current, e.clientX, e.clientY);
      const h = Math.max(8, Math.min(140, 72 - q.y));
      const i = dragBar.current;
      setBars((b) => b.map((v, j) => (j === i ? Math.round(h) : v)));
    }
  };
  const endDrag = () => {
    drawing.current = null;
    dragBar.current = -1;
  };

  const startDraw = (e: React.PointerEvent) => {
    if (!sketchRef.current) return;
    e.stopPropagation();
    (e.target as Element).setPointerCapture?.(e.pointerId);
    const q = svgPoint(sketchRef.current, e.clientX, e.clientY);
    drawing.current = `M${q.x.toFixed(1)} ${q.y.toFixed(1)}`;
    const d = drawing.current;
    setLines((l) => [...l.slice(-30), d + " l0.1 0"]);
  };
  const sip = () => {
    setSips((s) => (s >= 4 ? 0 : s + 1));
    setRipple((r) => r + 1);
  };
  const nextScreen = () => {
    setScreen((s) => (s + 1) % 3);
    setScan((n) => n + 1);
  };
  const toggleMusic = () => {
    if (beat.current) {
      beat.current.stop();
      beat.current = null;
      setPlaying(false);
    } else {
      beat.current = makeBeat();
      setPlaying(!!beat.current);
    }
  };
  const mean = Math.round(bars.reduce((a, b) => a + b, 0) / bars.length);
  const level = 1 - sips / 5;
  const lamp = P.lamp;
  const pool = light || { x: lamp.x + 120, y: lamp.y + 200 };
  const vb = port ? "0 0 900 1000" : "0 0 1600 900";
  const W = port ? 900 : 1600, H = port ? 1000 : 900;
  const key = (e: React.KeyboardEvent, fn: () => void) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      fn();
    }
  };

  return (
    <svg
      ref={svg}
      className={"lns-ab__room lns-ab__desk" + (playing ? " is-playing" : "")}
      viewBox={vb}
      preserveAspectRatio={port ? "xMidYMid meet" : "xMidYMid slice"}
      onPointerMove={onMoveDesk}
      onPointerUp={endDrag}
      onPointerLeave={endDrag}
    >
      <defs>
        <radialGradient id="dkPool">
          <stop offset="0" stopColor="#ffbe7a" stopOpacity=".42" />
          <stop offset=".55" stopColor="#ffbe7a" stopOpacity=".12" />
          <stop offset="1" stopColor="#ffbe7a" stopOpacity="0" />
        </radialGradient>
        <pattern id="dkGrid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M40 0H0V40" fill="none" stroke="rgba(237,29,4,.13)" strokeWidth="1" />
        </pattern>
        <clipPath id="dkScr">
          <rect x="-212" y="-186" width="424" height="166" rx="4" />
        </clipPath>
      </defs>

      {/* the desk */}
      <rect className="dk-top" x="-200" y="-200" width={W + 400} height={H + 400} />
      <rect x="-200" y="-200" width={W + 400} height={H + 400} fill="url(#dkGrid)" className="dk-grid" />
      <circle className="dk-pool" cx={pool.x} cy={pool.y} r={port ? 260 : 340} fill="url(#dkPool)" style={arrive(0)} />

      {/* 22:00 the lamp: its light follows you */}
      <g transform={at2("lamp")}>
        <g className="dk-ob" style={arrive(0)}>
          <rect className="dk-foot" x="-70" y="-70" width="140" height="140" rx="70" />
          <circle className="dk-fill" r="34" />
          <path className="dk-ink" d={`M0 0L${Math.max(-90, Math.min(90, (pool.x - lamp.x) * 0.25)).toFixed(0)} ${Math.max(-40, Math.min(110, (pool.y - lamp.y) * 0.25)).toFixed(0)}`} strokeWidth="8" strokeLinecap="round" />
          <circle className="dk-bulb" cx={Math.max(-90, Math.min(90, (pool.x - lamp.x) * 0.25))} cy={Math.max(-40, Math.min(110, (pool.y - lamp.y) * 0.25))} r="22" />
        </g>
        <text className="dk-tag" x="-60" y="-56" style={arrive(0)}>Lamp · 2700 K</text>
      </g>

      {/* 23:00 the laptop: tap the screen */}
      <g transform={at2("laptop")}>
        <rect className="dk-foot" x="-250" y="-215" width="500" height="410" rx="22" style={arrive(1)} />
        <g className="dk-ob" style={arrive(1)}>
          <rect className="dk-dark" x="-230" y="-200" width="460" height="194" rx="14" />
          <g
            className={"dk-hit" + (ready("laptop") ? "" : " is-off")}
            onClick={nextScreen}
            onKeyDown={(e) => key(e, nextScreen)}
            role="button"
            tabIndex={ready("laptop") ? 0 : -1}
            aria-label="Show what's on the laptop"
          >
            <g clipPath="url(#dkScr)">
              <rect x="-212" y="-186" width="424" height="166" fill={screen === 2 ? "#28272a" : "#f3efe9"} />
              {screen === 0 && (
                <g>
                  <rect x="-200" y="-176" width="400" height="12" rx="3" fill="#e2ddd5" />
