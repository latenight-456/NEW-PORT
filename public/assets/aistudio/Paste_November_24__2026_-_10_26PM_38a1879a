                  <rect x="-200" y="-126" width="160" height="18" rx="3" fill="#28272a" />
                  <rect x="-200" y="-98" width="190" height="6" rx="3" fill="#bdb7ae" />
                  <rect x="-200" y="-70" width="78" height="22" rx="11" fill="#ed1d04" />
                  <rect x="30" y="-150" width="170" height="104" rx="8" fill="#d6d0c6" />
                  <circle cx="115" cy="-98" r="24" fill="#ed1d04" opacity=".85" />
                </g>
              )}
              {screen === 1 && (
                <g>
                  <rect x="-212" y="-186" width="70" height="166" fill="#28272a" />
                  {[0, 1, 2, 3].map((i) => (
                    <rect key={i} x={-190} y={-160 + i * 26} width="28" height="6" rx="3" fill={i === 1 ? "#ed1d04" : "#6b6760"} />
                  ))}
                  {[52, 80, 64, 110, 92, 124].map((h, i) => (
                    <rect key={i} x={-120 + i * 44} y={-34 - h} width="26" height={h} rx="4" fill={i === 5 ? "#ed1d04" : "#bdb7ae"} />
                  ))}
                  <rect x="-120" y="-176" width="120" height="10" rx="3" fill="#28272a" />
                </g>
              )}
              {screen === 2 && (
                <svg x="-60" y="-170" width="120" height="134" viewBox={MARK_VB}>
