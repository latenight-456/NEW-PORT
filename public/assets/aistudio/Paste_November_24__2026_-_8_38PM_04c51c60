            {STORY.map((s, i) => (
              <p key={i}>{s}</p>
            ))}
            <span className="lns-ab__sig">{SIGNATURE}</span>
          </div>
        </div>
      </div>
      <Night />
      <Road />
      <Rules />
    </section>
  );
}

