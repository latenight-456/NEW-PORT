function Night() {
  const ref = useRef<HTMLDivElement>(null);
  const stageRef = useRef<HTMLDivElement>(null);
  const clockRef = useRef<HTMLSpanElement>(null);
  const [step, setStep] = useState(0);
  const [still, setStill] = useState(false);

  useEffect(() => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sec = ref.current!, stage = stageRef.current!;
    const put = (p: number) => {
      stage.style.setProperty("--p", p.toFixed(3));
      const s = Math.min(6, Math.floor(p));
      setStep((o) => (o === s ? o : s));
      const mins = 22 * 60 + Math.min(6, p) * 60;
      const m = Math.round(mins / 5) * 5;
      if (clockRef.current) clockRef.current.textContent = `${String(Math.floor(m / 60) % 24).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
    };
    if (reduce) {
      setStill(true);
      put(7);
      return;
    }
    let raf = 0;
    const read = () => {
      raf = 0;
      const r = sec.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      const p = span > 0 ? Math.max(0, Math.min(1, -r.top / span)) * 7 : 7;
      put(p);
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(read);
    };
    read();
    window.addEventListener("scroll", kick, { passive: true });
    window.addEventListener("resize", kick);
    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener("scroll", kick);
      window.removeEventListener("resize", kick);
    };
  }, []);

  return (
    <div ref={ref} className={"lns-ab__night" + (still ? " is-still" : "")}>
      <div ref={stageRef} className="lns-ab__stage">
        <Room />
        <div className="lns-ab__hud">
          <span className="lns-ab__eyebrow">{NIGHT_EYEBROW}</span>
          <span className="lns-ab__clock">
            <span ref={clockRef}>22:00</span>
            <small>Accra · GMT</small>
          </span>
        </div>
        <div className="lns-ab__caps" aria-live="polite">
          {STEPS.map(([t, line], i) => (
            <div key={i} className={"lns-ab__cap" + (i === step ? " is-on" : "")} aria-hidden={i !== step}>
              <span className="lns-ab__count">
                <b>{String(i + 1).padStart(2, "0")}</b>
                <i />
                {String(STEPS.length).padStart(2, "0")}
              </span>
              <h3>{t}</h3>
              <p>{line}</p>
              {i === STEPS.length - 1 && (
                <button type="button" className="lns-ab__btn" onClick={() => openContactOverlay()} tabIndex={i === step ? 0 : -1}>
                  {CTA}
                  <span className="lns-ab__go">
                    <Arrow />
                  </span>
                </button>
              )}
            </div>
          ))}
        </div>
        <div className="lns-ab__dots" aria-hidden="true">
          {STEPS.map((_, i) => (
            <i key={i} className={i <= step ? "is-on" : ""} />
          ))}
        </div>
      </div>
    </div>
  );
}

function Road() {
  const ref = useRef<HTMLOListElement>(null);
  useEffect(() => {
    const el = ref.current!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let raf = 0;
    const read = () => {
      raf = 0;
      const r = el.getBoundingClientRect();
      const line = window.innerHeight * 0.6;
      const f = reduce ? 1 : Math.max(0, Math.min(1, (line - r.top) / r.height));
      el.style.setProperty("--f", f.toFixed(3));
      el.querySelectorAll<HTMLElement>(".lns-ab__stop").forEach((li) => {
        li.classList.toggle("is-past", reduce || li.getBoundingClientRect().top + 14 < line);
      });
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(read);
    };
    read();
    window.addEventListener("scroll", kick, { passive: true });
    window.addEventListener("resize", kick);
    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener("scroll", kick);
      window.removeEventListener("resize", kick);
    };
  }, []);
  return (
    <div className="lns-ab__road">
      <h2 className="lns-ab__h">{ROAD_TITLE}</h2>
      <ol ref={ref} className="lns-ab__line">
        {TIMELINE.map((t, i) => (
          <li key={i} className="lns-ab__stop">
            <span className="lns-ab__year">{t.year}</span>
            <div>
              <h3>{t.title}</h3>
              {t.where && <em>{t.where}</em>}
              <p>{t.text}</p>
            </div>
          </li>
        ))}
        <li className="lns-ab__stop lns-ab__stop--next">
          <span className="lns-ab__year">Now</span>
          <div>
            <h3>{NEXT}</h3>
            <button type="button" className="lns-ab__btn" onClick={() => openContactOverlay()}>
              {CTA}
              <span className="lns-ab__go">
                <Arrow />
              </span>
            </button>
          </div>
        </li>
      </ol>
      {CERTS.length > 0 && (
        <div className="lns-ab__certs">
          <span className="lns-ab__eyebrow">{CERTS_TITLE}</span>
          <ul>
            {CERTS.map(([c, from], i) => (
              <li key={i}>
                <b>{c}</b>
                {from && <em>{from}</em>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  );
}

