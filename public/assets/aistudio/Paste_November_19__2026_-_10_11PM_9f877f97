```

The heading is now **scroll-driven**: the section is tall and the heading stays pinned while you scroll through it. Scrolling down plays the animation forward and scrolling up plays it backward. **Important:** `position: sticky` breaks inside any parent with `overflow: hidden` or `overflow: auto`. If the rounded panel (or any ancestor) around `<DotMatrixHeading />` has `overflow: hidden`, change it to `overflow: clip` for that panel. Do not wrap the component in anything with a fixed height.


## 4. Work section
Create `components/WorkInProgress.tsx` with the code below. Replace the current Work section ("Work / Coming next") with `<WorkInProgress />` inside the existing rounded panel. It has `id="work"`; make sure the nav "My Work" link points to `#work`.

```tsx
import React, { useEffect, useRef, useState } from "react";

/* Late Night Studio: Work section placeholder (replaces "Coming next").
   PROGRESS is a real number YOU update as case studies get finished. Keep it honest:
   a bar stuck at 99% for months looks worse than no bar at all. */

const PROGRESS = 60; // 0-100
const BUILDING = [
  { name: "Case study 01", status: "Writing" },
  { name: "Case study 02", status: "Designing" },
  { name: "Case study 03", status: "Planned" },
];

export default function WorkInProgress() {
  const ref = useRef<HTMLElement>(null);
  const [count, setCount] = useState(0);
  const [started, setStarted] = useState(false);

  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setCount(PROGRESS);
      setStarted(true);
      return;
    }
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        setStarted(true);
        const t0 = performance.now();
        const dur = 1600;
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / dur);
          const eased = 1 - Math.pow(1 - k, 3);
          setCount(Math.round(eased * PROGRESS));
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      },
      { threshold: 0.4 }
    );
    io.observe(el);
    return () => io.disconnect();
  }, []);

  return (
    <section id="work" ref={ref} className="lns-wip" aria-labelledby="lns-wip-title">
      <style>{CSS}</style>
      <h2 id="lns-wip-title" className="lns-wip__title">WORK.</h2>
      <p className="lns-wip__status">
        <span className="lns-wip__light" aria-hidden="true" /> Under construction
      </p>

      <div
        className="lns-wip__meter"
        role="progressbar"
        aria-valuemin={0}
        aria-valuemax={100}
        aria-valuenow={PROGRESS}
        aria-label="Case studies progress"
      >
        <div className="lns-wip__fill" style={{ width: started ? `${PROGRESS}%` : "0%" }} />
      </div>
      <p className="lns-wip__pct" aria-hidden="true">
        {count}
        <span>%</span>
      </p>

      <ul className="lns-wip__list">
        {BUILDING.map((b) => (
          <li key={b.name}>
            <span>{b.name}</span>
            <span className="lns-wip__tag">{b.status}</span>
          </li>
        ))}
      </ul>

      <p className="lns-wip__cta">
        Want your project to be one of them? <a href="#contact">Let's talk</a>
      </p>
    </section>
  );
}

const CSS = `
.lns-wip{
  --lns-paper:#cdc9c3;--lns-ink:#28272a;--lns-red:#ed1d04;--lns-muted:#5e5a57;--lns-line:rgba(40,39,42,.22);
  --lns-display:inherit;--lns-body:inherit;
  max-width:720px;margin:0 auto;padding:96px 24px;text-align:center;color:var(--lns-ink);font-family:var(--lns-body)}
.lns-wip__title{font-family:var(--lns-display);font-size:clamp(40px,6vw,64px);line-height:1;margin:0 0 16px;letter-spacing:.02em}
.lns-wip__status{display:inline-flex;align-items:center;gap:8px;margin:0 0 40px;font-size:14px;
  padding:6px 14px;border:1px solid var(--lns-line);border-radius:999px}
.lns-wip__light{width:8px;height:8px;border-radius:50%;background:var(--lns-red);animation:lns-wip-blink 1.2s steps(2) infinite}
@keyframes lns-wip-blink{50%{opacity:.15}}

/* construction-tape progress bar */
.lns-wip__meter{height:22px;border-radius:999px;border:2px solid var(--lns-ink);overflow:hidden;background:transparent}
.lns-wip__fill{height:100%;border-radius:999px;transition:width 1.6s cubic-bezier(.22,.61,.36,1);
  background:repeating-linear-gradient(-45deg,var(--lns-red) 0 12px,var(--lns-ink) 12px 24px);
  background-size:34px 34px;animation:lns-wip-tape 1s linear infinite}
@keyframes lns-wip-tape{to{background-position:34px 0}}
.lns-wip__pct{font-family:var(--lns-display);font-size:clamp(56px,10vw,112px);line-height:1;margin:20px 0 0;font-variant-numeric:tabular-nums}
.lns-wip__pct span{font-size:.45em;margin-left:4px;color:var(--lns-red)}

.lns-wip__list{list-style:none;margin:40px 0 0;padding:0;border-top:1px solid var(--lns-line);text-align:left}
.lns-wip__list li{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px 4px;border-bottom:1px solid var(--lns-line);font-size:16px}
.lns-wip__tag{font-size:12px;padding:4px 10px;border:1px solid var(--lns-line);border-radius:999px;color:var(--lns-muted)}
